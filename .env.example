# Resend (https://resend.com) — solo servidor, nunca usar prefijo NEXT_PUBLIC_
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx

# Correo que recibe los mensajes del formulario de contacto.
# Con el remitente sandbox onboarding@resend.dev solo se entrega al correo dueño de la cuenta Resend.
CONTACT_TO_EMAIL=destino@ejemplo.com

# Remitente. Cambiar a un dominio verificado en Resend cuando exista.
RESEND_FROM=Arcade Vault <onboarding@resend.dev>

SUPABASE_PASSWORD=XXXXXXXXX

NEXT_PUBLIC_SUPABASE_URL=xxx
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=xxxx

# Auth (spec 12): sin variables nuevas. En el dashboard de Supabase configurar a mano:
# - Auth > Providers > Email: "Confirm email" desactivado, longitud mínima 8
# - Auth > URL Configuration: Site URL y Redirect URLs (http://localhost:3000/** y producción)
# - Auth > Providers: Google y GitHub (client id/secret; callback https://<proyecto>.supabase.co/auth/v1/callback)
# - Auth > SMTP Settings: smtp.resend.com, usuario "resend", contraseña = RESEND_API_KEY
